{
  "theme": {
    "name": "Shoes Standardized",
    "version": "1.0.0",
    "engine": "liquid-like"
  },
  "contracts": {
    "models": [
      "store",
      "menu",
      "collection",
      "product",
      "cart",
      "page"
    ],
    "sections": [
      {
        "type": "header",
        "data": ["store", "menu", "cart"]
      },
      {
        "type": "hero",
        "data": ["page"]
      },
      {
        "type": "collection-grid",
        "data": ["collections"]
      },
      {
        "type": "featured-products",
        "data": ["products"]
      },
      {
        "type": "product-page",
        "data": ["product"]
      },
      {
        "type": "collection-page",
        "data": ["collection", "products"]
      },
      {
        "type": "footer",
        "data": ["store", "menu"]
      }
    ],
    "components": [
      {
        "type": "product-card",
        "data": ["product"]
      }
    ]
  }
}
