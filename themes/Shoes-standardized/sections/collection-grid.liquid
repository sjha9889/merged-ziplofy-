<section class="category-section">
  <div class="container category-shell">
    <h2>{{ section.settings.title | default: "Explore by Category" }}</h2>
    <div class="category-track" id="categoryTrack">
      {% for collection in collections %}
        <a href="/collections/{{ collection.handle }}" class="category-card">
          <img src="{{ collection.image | default: '' }}" alt="{{ collection.title }}">
          <span class="card-default">
            <small>SHOP</small>
            <strong>{{ collection.title }}</strong>
          </span>
        </a>
      {% else %}
        <p>No collections available.</p>
      {% endfor %}
    </div>
  </div>
</section>
