<header class="site-header">
  <div class="offer-strip">
    <div class="container header-row">
      <p class="offer-text">
        <span>{{ store.offer_primary | default: "🚚 Free Shipping on Orders Above ₹999" }}</span>
        <span class="divider">|</span>
        <span>{{ store.offer_secondary | default: "🎁 Extra 5% Off on Prepaid Orders" }}</span>
      </p>
      <a href="{{ store.offer_link | default: '#' }}" class="drop-link">{{ store.offer_cta | default: "New Drop Live →" }}</a>
    </div>
  </div>

  <div class="main-nav-wrap">
    <div class="container main-nav">
      <a href="/" class="brand">
        <span class="brand-title">{{ store.brand_primary | default: "STEP" }}<span class="accent">{{ store.brand_accent | default: "UP" }}</span></span>
        <span class="brand-sub">{{ store.brand_secondary | default: "SHOES" }}</span>
      </a>

      <nav class="primary-nav" id="primaryNav">
        {% for item in menu.primary %}
          <a href="{{ item.url }}">{{ item.label }}</a>
        {% else %}
          <a href="/products">Shop</a>
          <a href="/collection">Collections</a>
          <a href="/blog">Blog</a>
          <a href="/contact">Contact</a>
        {% endfor %}
      </nav>
    </div>
  </div>
</header>
