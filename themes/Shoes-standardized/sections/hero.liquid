<section class="cinematic-hero">
  <div class="hero-slides">
    {% for slide in page.hero_slides %}
      <article class="hero-slide {% if forloop.first %}is-active{% endif %}" style="background-image: url('{{ slide.image }}');">
        <div class="hero-inner container">
          <div class="hero-copy">
            <p class="drop-tag">{{ slide.tag }}</p>
            <h1>{{ slide.title }}</h1>
            <p class="hero-sub">{{ slide.subtitle }}</p>
            <div class="hero-cta">
              <a href="{{ slide.cta_url | default: '/products' }}" class="btn-primary">{{ slide.cta_label | default: 'SHOP NOW' }}</a>
            </div>
          </div>
        </div>
      </article>
    {% else %}
      <article class="hero-slide is-active" style="background-image: url('{{ 'assets/img/banner-1.png' | asset_url }}');">
        <div class="hero-inner container">
          <div class="hero-copy">
            <p class="drop-tag">NEW DROP</p>
            <h1>Custom Is The New Cool</h1>
            <p class="hero-sub">Design your vibe. Your color. Your way.</p>
            <div class="hero-cta">
              <a href="/products" class="btn-primary">SHOP NOW</a>
            </div>
          </div>
        </div>
      </article>
    {% endfor %}
  </div>
</section>
