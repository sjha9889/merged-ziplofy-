<section class="bestseller-section">
  <div class="container">
    <div class="bestseller-head">
      <h2>{{ section.settings.title | default: "Top Sneaker Picks" }}</h2>
      <a href="/products" class="view-all-link">{{ section.settings.cta_label | default: "Explore All" }}</a>
    </div>
    <div class="bestseller-track">
      {% for product in products %}
        {% render 'product-card', product: product %}
      {% else %}
        <p>No featured products yet.</p>
      {% endfor %}
    </div>
  </div>
</section>
