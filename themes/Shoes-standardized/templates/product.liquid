{% layout 'main' %}
<link rel="stylesheet" href="{{ 'assets/css/product.css' | asset_url }}">
<section class="product-layout">
  <div class="product-visual">
    <div class="product-image-stage">
      <img id="productImage" src="{{ product.image | default: product.images[0] | default: '' }}" alt="{{ product.title }}">
    </div>
  </div>

  <div class="product-panel">
    <div class="title-row">
      <h1 id="productTitle">{{ product.title }}</h1>
      <p class="rating-score">{{ product.rating | default: "4.8" }}</p>
    </div>

    <p class="subtitle" id="productTag">{{ product.subtitle | default: product.vendor }}</p>
    <p class="price-line">
      <strong id="productNewPrice">{{ product.price | money }}</strong>
      {% if product.compare_at_price %}
        <del id="productOldPrice">{{ product.compare_at_price | money }}</del>
      {% endif %}
    </p>

    <div class="info-accordion product-info-accordion">
      <article class="info-item is-open">
        <button type="button" class="info-toggle" aria-expanded="true">
          <span>Description</span>
          <i class="bi bi-chevron-up"></i>
        </button>
        <div class="info-content">
          <p>{{ product.description }}</p>
        </div>
      </article>
    </div>
  </div>
</section>
<script src="{{ 'assets/js/product.js' | asset_url }}"></script>
