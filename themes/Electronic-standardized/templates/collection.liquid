{% layout 'main' %}
<link rel="stylesheet" href="{{ 'assets/css/category.css' | asset_url }}">
<main class="category-page" aria-label="Category listing">
  <section class="products-panel" aria-label="Products">
    <h1>{{ collection.title }}</h1>
    <div class="products-grid">
      {% for product in products %}
        {% render 'product-card', product: product %}
      {% else %}
        <p>No products in this collection.</p>
      {% endfor %}
    </div>
  </section>
</main>
<script src="{{ 'assets/js/category-filters.js' | asset_url }}"></script>
<script src="{{ 'assets/js/product-linker.js' | asset_url }}"></script>
