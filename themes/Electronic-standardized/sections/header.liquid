<header class="vs-header" role="banner">
  <div class="vs-header__inner">
    <div class="vs-header__main">
      <div class="vs-header__left">
        <a href="/" class="vs-logo">{{ store.name | default: "Voltix" }}</a>
      </div>
      <div class="vs-header__search">
        <div class="vs-search" role="search">
          <input type="search" class="vs-search__input" placeholder="{{ store.search_placeholder | default: 'Search for phone, TV, home appliances...' }}" autocomplete="off" aria-label="Search products">
        </div>
      </div>
      <div class="vs-header__actions">
        <a href="/account" class="vs-icon-btn vs-icon-btn--account" aria-label="Account"><i class="fa-regular fa-user"></i></a>
        <a href="/cart" class="vs-icon-btn" aria-label="Shopping cart"><i class="fa-solid fa-cart-shopping"></i></a>
      </div>
    </div>

    <nav class="vs-header__categories" aria-label="Primary categories">
      {% for item in menu.primary %}
        <a href="{{ item.url }}">{{ item.label }}</a>
      {% else %}
        <a href="/collections">All Categories</a>
        <a href="/products">Mobiles</a>
        <a href="/products">Laptops</a>
        <a href="/products">TV & Entertainment</a>
      {% endfor %}
    </nav>
  </div>
</header>
