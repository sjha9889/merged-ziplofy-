<section class="whats-hot" aria-label="Collections">
  <div class="whats-hot__inner">
    <h2 class="whats-hot__title">{{ section.settings.title | default: "Shop by category" }}</h2>
    <div class="whats-hot__grid">
      {% for collection in collections %}
        <a href="/collections/{{ collection.handle }}" class="promo-card" aria-label="{{ collection.title }}">
          <img src="{{ collection.image | default: '' }}" alt="{{ collection.title }}">
        </a>
      {% else %}
        <p>No collections available.</p>
      {% endfor %}
    </div>
  </div>
</section>
