<section class="ac-hero" aria-label="Featured promotion" id="heroSection">
  <div class="ac-hero__bg" id="heroBg" style="background-image: url('{{ page.hero_image | default: ('assets/img/banner-1.png' | asset_url) }}');"></div>
  <div class="ac-hero__overlay"></div>
  <div class="ac-hero__bottom">
    <div class="ac-hero__content">
      <div class="ac-hero__copy">
        <span class="ac-hero__brand">{{ store.name | default: "Voltix" }}</span>
        <span class="ac-badge">{{ page.hero_badge | default: "Latest Launch" }}</span>
        <h1 class="ac-hero__title">{{ page.hero_title | default: "Electronics" }}</h1>
        <p class="ac-hero__price">{{ page.hero_price_text | default: "Starting at ₹23,990*" }}</p>
        <a href="{{ page.hero_cta_url | default: '/collections' }}" class="ac-hero__cta">{{ page.hero_cta_label | default: "Shop now" }}</a>
      </div>
    </div>
  </div>
</section>
