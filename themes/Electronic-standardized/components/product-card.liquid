<article class="p-card" data-product="{{ product.handle | default: product._id }}">
  <div class="p-card__media">
    <div class="p-card__img-wrap">
      <div class="p-card__img">
        <img src="{{ product.image | default: product.images[0] | default: '' }}" alt="{{ product.title }}">
      </div>
    </div>
  </div>
  <div class="p-card__body">
    <h3>{{ product.title }}</h3>
    <div class="p-card__price-row">
      <span class="p-card__price">{{ product.price | money }}</span>
      {% if product.compare_at_price %}
        <span class="p-card__mrp-wrap"><s class="p-card__mrp">{{ product.compare_at_price | money }}</s></span>
      {% endif %}
    </div>
  </div>
</article>
