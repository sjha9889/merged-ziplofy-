{
  "name": "payment-gateway",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "backend": "npm run start --prefix backend",
    "backend:dev": "npm run dev --prefix backend",
    "dev:all": "concurrently -k -n web,api -c cyan,magenta \"npm run dev\" \"npm run dev --prefix backend\"",
    "build": "vite build",
    "preview": "vite preview",
    "start:prod": "npm run build && cross-env SERVE_FRONTEND=1 npm run start --prefix backend"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "vite": "^6.0.3"
  }
}
