# --- MERN backend (MongoDB + Express + Node) ---
# Copy to .env and adjust values.

PORT=3001

# Required: MongoDB connection string
# Local (install MongoDB or run: docker compose -f docker-compose.yml up -d)
MONGODB_URI=mongodb://127.0.0.1:27017/payment-gateway

# Atlas example:
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/payment-gateway?retryWrites=true&w=majority

# Comma-separated browser origins allowed for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Set to 1 to serve ../dist and enable SPA fallback (run "npm run build" in project root first)
# SERVE_FRONTEND=0
