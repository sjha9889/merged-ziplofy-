{
  "id": "makeup",
  "name": "Lumière Beauty",
  "version": "1.0.0",
  "type": "react-remote",
  "configMode": "sections",
  "assets": {
    "themeJs": "theme.js",
    "themeCss": "theme.css",
    "defaultConfig": "theme.default-config.json",
    "schema": "theme.schema.json"
  },
  "templates": ["index", "product", "cart", "login", "signup", "forgot_password", "profile", "orders"],
  "capabilities": {
    "sections": true,
    "blocks": true,
    "globalSettings": true,
    "livePreview": true
  }
}
